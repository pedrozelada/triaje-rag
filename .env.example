# ===========================================
# Proveedores LLM (ai_service/providers)
# Cada proveedor se activa solo si está configurado.
# ===========================================

# --- Groq (Nube - Rápido) ---
GROQ_API_KEY=api_key
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TEMPERATURE=0.1
# GROQ_MAX_TOKENS=1024

# --- Gemini (Nube - Google) ---
# Requiere: pip install llama-index-llms-google-genai
# Modelos vigentes del catálogo (los 2.x ya no están disponibles para cuentas
# nuevas); alternativas: gemini-3.1-flash-lite (más rápido), gemini-3.7-flash.
GEMINI_API_KEY=api_key
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_TEMPERATURE=0.1
# GEMINI_MAX_TOKENS=4096
# GEMINI_THINKING_BUDGET=0

# --- OpenAI (Nube - GPT) [opcional] ---
# Requiere: pip install llama-index-llms-openai
# OPENAI_API_KEY=api_key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.1
# OPENAI_MAX_TOKENS=1024

# --- Modelo Local (Ollama / LM Studio) ---
OLLAMA_BASE_URL=http://localhost:1234/v1
# OLLAMA_MODEL=local-model
# OLLAMA_TIMEOUT=300
# OLLAMA_CONTEXT_WINDOW=8192

# ===========================================
# Rutas
# ===========================================
DATA_DIR=./data
CHROMA_PATH=./chroma_db

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
